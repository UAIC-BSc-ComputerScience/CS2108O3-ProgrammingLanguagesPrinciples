  "algorithms": [
    {
      "id": "lecture6-algorithm-1",
      "text": "language constructs as inference rules"
    },
    {
      "id": "lecture6-algorithm-2",
      "text": "▶ Big-step SOS for a PL: a set of inference rules"
    }
  ],
  "formulas": [
    {
      "id": "lecture6-formula-1",
      "expression": "BIGSTEP -LOOKUP : ⟨x, σ⟩⇓⟨ σ(x)⟩ ifσ(x)̸=⊥"
    },
    {
      "id": "lecture6-formula-2",
      "expression": "▶ A derivation example whereσ(n) = 10:"
    },
    {
      "id": "lecture6-formula-3",
      "expression": "⟨x ::= a, σ⟩⇓⟨ σ[i/x]⟩ ifσ(x)̸=⊥"
    },
    {
      "id": "lecture6-formula-4",
      "expression": "⟨i::=0;;while i<1 (i::=i+1),σ⟩⇓⟨ (σ[0/i])[1/i]⟩."
    },
    {
      "id": "lecture6-formula-5",
      "expression": "⟨i::=0,σ⟩⇓⟨ σ[0/i]⟩ ASSIGN A"
    },
    {
      "id": "lecture6-formula-6",
      "expression": "⟨i::=0;;while i<1 (i::=i+1),σ⟩⇓⟨ (σ[0/i])[1/i]⟩ SEQ"
    },
    {
      "id": "lecture6-formula-7",
      "expression": "⟨while i<1 (i::=i+1),σ [0/i]⟩⇓⟨ (σ[0/i])[1/i]⟩ WHILE TRUE"
    },
    {
      "id": "lecture6-formula-8",
      "expression": "⟨i::=i+1⟩⇓⟨ (σ[0/i])[1/i]⟩ ASSIGN C"
    },
    {
      "id": "lecture6-formula-9",
      "expression": "⟨i::=i+1;;while i<2 (i::=i+1),σ [0/i]⟩⇓⟨ (σ[0/i])[1/i]⟩ SEQ"
    },
    {
      "id": "lecture6-formula-10",
      "expression": "⟨while i<1 (i::=i+1), (σ[0/i])[1/i]⟩⇓⟨ (σ[0/i])[1/i]⟩ WHILE FALSE"
    }
  ],
